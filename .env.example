# --- Plex (required) ---
# Server owner's token: Plex Web > any item > ⋯ > Get Info > View XML > X-Plex-Token in the URL.
PLEX_TOKEN=
# How the container reaches Plex (required), e.g. http://192.168.1.10:32400 or https://plex.example.com
PLEX_URL=
# Address opened in your browser when clicking a title (defaults to PLEX_URL).
# PLEX_PUBLIC_URL=https://plex.example.com
# Set to true if PLEX_URL uses a self-signed certificate.
# PLEX_INSECURE_TLS=false

# --- This app ---
# Public address of RecPick (used for the Plex sign-in redirect and links in emails).
# APP_URL=http://192.168.1.10:8080
# Nightly guide refresh (cron, in TZ); alerts and the daily email go out right after.
SYNC_CRON=0 3 * * *
# Time zone for the nightly refresh and email times, e.g. Europe/Warsaw, Europe/London, America/New_York
TZ=UTC
# Language for new users and emails (each user can change it): en, pl
DEFAULT_LANGUAGE=en

# --- Optional: TMDB ratings (free key from themoviedb.org > Settings > API) ---
# TMDB_API_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
# true for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RecPick <you@example.com>

# --- Container ---
# User/group the app runs as inside the container (the data folder is made writable for them).
# PUID=1000
# PGID=1000
